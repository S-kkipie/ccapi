{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["plugins/ccapi/src", "plugins/ccapi/bridge", "e2e"]
}
