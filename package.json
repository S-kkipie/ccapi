{
  "name": "ccapi",
  "version": "0.1.0",
  "description": "Use your Claude Code subscription as a local Anthropic-compatible API: native tools, streaming, images.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "api",
    "litellm",
    "proxy",
    "llm"
  ],
  "scripts": {
    "test": "bun test ./plugins/ccapi/src/__tests__ ./plugins/ccapi/bridge/__tests__",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.src.json",
    "typecheck:plugins": "tsc -p plugins/ccapi && tsc -p plugins/ccapi-spawn",
    "validate": "claude plugin validate plugins/ccapi && claude plugin validate plugins/ccapi-spawn",
    "test:plugin": "claude plugin test plugins/ccapi",
    "e2e": "CCAPI_E2E=1 bun test ./e2e"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/bun": "^1.4.4",
    "openai": "^7.43.0",
    "typescript": "^5.8"
  }
}
